<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== 深色主题基础色 ===== -->

    <!-- 最深背景色 — 整个 Dashboard 的底色 -->
    <color name="background_dark">#0A0E14</color>

    <!-- 卡片/面板表面色 — 比背景略亮,用于区分层次 -->
    <color name="surface_dark">#141B26</color>

    <!-- 更亮的表面色 — 用于列表项、按钮背景等 -->
    <color name="surface_light">#1E2A38</color>

    <!-- 分隔线颜色 -->
    <color name="divider">#2A3441</color>

    <!-- ===== 强调色(科技感霓虹) ===== -->

    <!-- 青色 — 主强调色,用于速度、电量等关键数值 -->
    <color name="accent_cyan">#00D4FF</color>

    <!-- 绿色 — 正向状态(GPS 锁定、已连接) -->
    <color name="accent_green">#00FF88</color>

    <!-- 红色 — 警告/停止按钮 -->
    <color name="accent_red">#FF3B3B</color>

    <!-- 橙色 — 提示/未连接状态 -->
    <color name="accent_orange">#FF9500</color>

    <!-- ===== 文字颜色 ===== -->

    <!-- 主要文字 — 标签、次要数值 -->
    <color name="text_primary">#E0E0E0</color>

    <!-- 次要文字 — 小标签、说明文字 -->
    <color name="text_secondary">#8E8E93</color>

    <!-- ===== 透明色 ===== -->

    <color name="transparent">#00000000</color>
    <color name="semi_transparent_dark">#AA0A0E14</color>

    <!-- ===== 启动图标 ===== -->
    <color name="ic_launcher_background">#0A0E14</color>

</resources>
